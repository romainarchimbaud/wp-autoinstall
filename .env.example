# Fichier modèle : `make setup` (lancé par `make autoinstall`) le copie en .env et remplit les valeurs.
# Le nom du dossier sert de nom de projet Docker : choisis-le unique.

# Site et admin ---------------------------------------------------------------
# Titre du site
WORDPRESS_WEBSITE_TITLE="Mon site WordPress"
# Identifiant de connexion à wp-admin (vide : make setup le demande)
WORDPRESS_ADMIN_USER=
# E-mail admin
WORDPRESS_ADMIN_EMAIL=user@example.com
# Mot de passe admin (vide : make setup en génère un)
WORDPRESS_ADMIN_PASSWORD=
# Thème à installer et activer (slugs cochés dans plugins.md)
WP_THEME=
# Plugins à installer et activer (slugs cochés dans plugins.md)
WP_PLUGINS=
# Node et npm dans l'image (true/false)
INSTALL_NODE=false

# Ports hôte ------------------------------------------------------------------
# Choisis par make setup puis gardés : l'URL locale est http://localhost:HTTP_PORT
HTTP_PORT=
# Port de phpMyAdmin
PHPMYADMIN_PORT=

# Base de données -------------------------------------------------------------
# Mot de passe de la base (vide : make setup en génère un)
DATABASE_PASSWORD=
# Préfixe des tables locales (les synchros réécrivent le préfixe dans le SQL, jamais ici)
WORDPRESS_TABLE_PREFIX=wp_

# Debug -----------------------------------------------------------------------
# WP_DEBUG (journal dans wp-content/debug.log)
WORDPRESS_DEBUG=true
# Affichage des erreurs dans les pages
WORDPRESS_DEBUG_DISPLAY=false

# Synchro (make help) ------------------------------------------------------------
# Alias SSH du staging et de la prod (make ssh-alias les crée et les écrit ici)
STAGING_SSH=
PROD_SSH=
# Dossier du site distant, relatif au dossier de connexion SSH
STAGING_PATH=staging
PROD_PATH=public_html
# URL du site de staging
STAGING_URL=
# URL du site de production
PROD_URL=
# Dossier du thème enfant (wp-content/themes/…) : exclu des synchros, envoyé par make deploy-theme-*
THEME_SLUG=
# Dossiers de wp-content jamais transférés, séparés par des espaces (ex. uploads/2012 uploads/2013)
SYNC_EXCLUDES=
# Nom de la commande WP-CLI sur les serveurs si ce n'est ni « wp » ni « wp-cli »
# (« wp » et « wp-cli » sont testés automatiquement)
WP_CMD=
